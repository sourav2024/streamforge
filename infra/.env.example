# Local infra overrides for docker-compose.yml. Copy to infra/.env to customize.
# The compose file has sensible dev defaults, so this file is OPTIONAL.
# These are DEV-ONLY credentials — never commit real secrets (see concept doc §4).

# Postgres
POSTGRES_USER=streamforge
POSTGRES_PASSWORD=streamforge
POSTGRES_DB=streamforge
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=streamforge
MINIO_ROOT_PASSWORD=streamforge
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
