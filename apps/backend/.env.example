# Backend configuration. Copy to `.env` (gitignored) and adjust locally.
# Phase 0 only needs HOST/PORT. Postgres/Redis/MinIO vars arrive in Phase 1.

HOST=0.0.0.0
PORT=3000
NODE_ENV=development

# Postgres (matches infra/docker-compose.yml defaults).
# Host port 5433 avoids clashing with a native/Homebrew Postgres on 5432.
DATABASE_URL=postgres://streamforge:streamforge@localhost:5433/streamforge

# MinIO / S3 (matches infra/docker-compose.yml defaults)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=streamforge
S3_SECRET_ACCESS_KEY=streamforge
S3_BUCKET_RAW=streamforge-raw
S3_BUCKET_HLS=streamforge-hls
S3_FORCE_PATH_STYLE=true

# Redis (BullMQ broker — matches infra/docker-compose.yml defaults)
REDIS_URL=redis://localhost:6379

# Upload limits
UPLOAD_MAX_BYTES=524288000
